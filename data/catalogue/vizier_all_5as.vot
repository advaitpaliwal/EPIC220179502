      <VALUES null="NaN" />
    </FIELD>
    <FIELD name="like" ucd="stat.likelihood;phys.energy;obs" datatype="double" width="24" precision="E17"><!-- ucd="STAT_LIKELIHOOD" -->
      <DESCRIPTION>? Highest detection log likelihood across all stacked observations and energy bands (likelihood)</DESCRIPTION>
      <VALUES null="NaN" />
    </FIELD>
