    </FIELD>
    <FIELD name="DEJ2000" ucd="pos.eq.dec;meta.main" ref="J2000" datatype="double" width="12" precision="8" unit="deg"><!-- ucd="POS_EQ_DEC_MAIN" -->
      <DESCRIPTION>Declination (J2000.0) of the group centre</DESCRIPTION>
    </FIELD>
    <FIELD name="z" ucd="src.redshift" datatype="double" width="10" precision="7"><!-- ucd="REDSHIFT_HC" -->
      <DESCRIPTION>Redshift of the group centre (CMB-corrected)</DESCRIPTION>
    </FIELD>
    <FIELD name="logLtot" ucd="phys.luminosity" datatype="double" width="10" precision="5" unit="log(solLum)"><!-- ucd="PHYS_LUMINOSITY_GENERAL" -->
      <DESCRIPTION>logarithm of the total (extrapolated) luminosity of the group (1)</DESCRIPTION>
    </FIELD>
