  <TABLE ID="J_MNRAS_524_1855_xpparams" name="J/MNRAS/524/1855/xpparams">
    <DESCRIPTION>Astrometrics and revised stellar atmospheric parameters of Gaia XP stars inferred from our data-driven model with straightforward built-in physical assumptions</DESCRIPTION>
<!-- Astrometrics and revised stellar atmospheric parameters of Gaia XP stars inferred from our data-driven model with straightforward built-in physical assumptions (\originalcolumnnames) -->

    <!-- RowName: -c=${$poseq}&-c.rs=0.004 -->
    <!-- Definitions of GROUPs and FIELDs -->

<!-- +++No column could be found to attach a LINK in table: J/MNRAS/524/1855/xpparams -->
    <FIELD name="_r" ucd="pos.angDistance" datatype="double" width="5" precision="3"><!-- ucd="POS_ANG_DIST_GENERAL" -->
      <DESCRIPTION>Distance from center (014.808160-00.807600)[ICRS], at Epoch=J2016.0</DESCRIPTION>
    </FIELD>
    <FIELD name="GaiaDR3" ucd="meta.id;meta.main" datatype="long" width="19"><!-- ucd="ID_MAIN" -->
      <DESCRIPTION>Gaia DR3 unique source identifier (gdr3_source_id)</DESCRIPTION>
      <LINK href="http://vizier.cds.unistra.fr/viz-bin/VizieR-4?-info=XML&amp;-out.add=.&amp;-source=I/355/gaiadr3,I/355/xpsummary,I/355/xpcont&amp;Source=${GaiaDR3}"/>
    </FIELD>
    <FIELD name="RA_ICRS" ucd="pos.eq.ra;meta.main" ref="H_2016.000" datatype="double" width="10" precision="6" unit="deg"><!-- ucd="POS_EQ_RA_MAIN" -->
      <DESCRIPTION>Truncated Gaia DR3 ICRS right ascension for this object (ICRS) at Ep=2016.0 (ra)</DESCRIPTION>
    </FIELD>
    <FIELD name="DE_ICRS" ucd="pos.eq.dec;meta.main" ref="H_2016.000" datatype="double" width="10" precision="6" unit="deg"><!-- ucd="POS_EQ_DEC_MAIN" -->
      <DESCRIPTION>Truncated Gaia DR3 ICRS declination for this object (ICRS) at Ep=2016.0 (dec)</DESCRIPTION>
    </FIELD>
    <FIELD name="Teff" ucd="phys.temperature.effective" datatype="double" width="7" precision="4" unit="1000K"><!-- ucd="PHYS_TEMP_EFFEC" -->
      <DESCRIPTION>Estimated effective Temperature (teff)</DESCRIPTION>
    </FIELD>
    <FIELD name="e_Teff" ucd="stat.error;phys.temperature.effective" datatype="double" width="8" precision="4" unit="1000K"><!-- ucd="ERROR" -->
      <DESCRIPTION>Error in estimated effective temperature (err_teff)</DESCRIPTION>
    </FIELD>
    <FIELD name="[Fe/H]" ucd="phys.abund.Fe;arith.ratio" datatype="double" width="7" precision="4" unit="log(Sun)"><!-- ucd="PHYS_ABUND_FE/H" -->
      <DESCRIPTION>Log of estimated Fe/H iron to hydrogen ratio (fe_h)</DESCRIPTION>
    </FIELD>
    <FIELD name="e_[Fe/H]" ucd="stat.error;phys.abund.Fe" datatype="double" width="8" precision="4" unit="log(Sun)"><!-- ucd="ERROR" -->
      <DESCRIPTION>Error in [Fe/H] (err_fe_h)</DESCRIPTION>
    </FIELD>
    <FIELD name="logg" ucd="phys.gravity" datatype="double" width="7" precision="4" unit="log(Sun)"><!-- ucd="PHYS_GRAVITY_SURFACE" -->
      <DESCRIPTION>Log of estimated surface gravity (logg)</DESCRIPTION>
    </FIELD>
    <FIELD name="e_logg" ucd="stat.error" datatype="double" width="8" precision="4" unit="log(Sun)"><!-- ucd="ERROR" -->
      <DESCRIPTION>Error of logg (err_logg)</DESCRIPTION>
    </FIELD>
    <FIELD name="Ext" ucd="phys.absorption" datatype="double" width="8" precision="4" unit="mag"><!-- ucd="PHOT_EXTINCTION_ISM" -->
      <DESCRIPTION>Estimated extinction parameter (ext) (1)</DESCRIPTION>
    </FIELD>
    <FIELD name="e_Ext" ucd="stat.error" datatype="double" width="8" precision="4" unit="mag"><!-- ucd="ERROR" -->
      <DESCRIPTION>Error of Ext (err_ext)</DESCRIPTION>
    </FIELD>
    <FIELD name="Plx" ucd="pos.parallax" datatype="double" width="8" precision="4" unit="mas"><!-- ucd="POS_PARLX_TRIG" -->
      <DESCRIPTION>Parallax estimated from the model (mod_parallax)</DESCRIPTION>
    </FIELD>
    <FIELD name="e_Plx" ucd="stat.error;pos.parallax" datatype="double" width="8" precision="4" unit="mas"><!-- ucd="ERROR" -->
      <DESCRIPTION>Error in the parallax estimated from the model (err_mod_parallax)</DESCRIPTION>
    </FIELD>
    <FIELD name="Quality" ucd="meta.code.qual" datatype="short" width="2"><!-- ucd="CODE_QUALITY" -->
      <DESCRIPTION>Quality flags in which the three least significant bits represent whether the confidence in effective temperature, [Fe/H] and log(g) is less than 0.5, respectively (quality_flags) (2)</DESCRIPTION>
    </FIELD>
    <FIELD name="Chi2" ucd="stat.fit;meta.modelled" datatype="char" arraysize="10*"><!-- ucd="FIT_CHI2" -->
      <DESCRIPTION>The {Chi}^2^ of the best-fit solution, divide by 61 to obtain {Chi}^2^ per degree of freedom (chi2_opt)</DESCRIPTION>
    </FIELD>
    <FIELD name="ln(Prior)" ucd="stat.param;meta.modelled" datatype="double" width="9" precision="4"><!-- ucd="MODEL_PARAM" -->
      <DESCRIPTION>Natural log of the GMM prior on stellar type, at the location of the optimal solution (ln_prior)</DESCRIPTION>
    </FIELD>
    <FIELD name="ConfTeff" ucd="meta.code" datatype="float" width="7" precision="4"><!-- ucd="CODE_MISC" -->
