      <VALUES null="NaN" />
    </FIELD>
    <FIELD name="Rad" ucd="phys.size.radius;pos.lg" datatype="double" width="10" precision="4" unit="kpc"><!-- ucd="PHYS_SIZE_RADIUS_GENERAL" -->
