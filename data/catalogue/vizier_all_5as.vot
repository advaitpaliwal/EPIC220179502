      <DESCRIPTION>ACT SZ detection right ascension (J2000)</DESCRIPTION>
    </FIELD>
    <FIELD name="DEJ2000" ucd="pos.eq.dec;meta.main" ref="J2000" datatype="double" width="9" precision="5" unit="deg"><!-- ucd="POS_EQ_DEC_MAIN" -->
      <DESCRIPTION>[-9.1/5] ACT SZ detection declination (J2000)</DESCRIPTION>
    </FIELD>
    <FIELD name="SNR" ucd="stat.snr" datatype="float" width="5" precision="2"><!-- ucd="INST_S/N" -->
      <DESCRIPTION>[4/24] SZ detection S/N optimized over all filter scales</DESCRIPTION>
    </FIELD>
    <FIELD name="SNR2p4" ucd="stat.snr" datatype="float" width="5" precision="2"><!-- ucd="INST_S/N" -->
      <DESCRIPTION>[3.5/24] SZ detection S/N at the 2.4' filter scale, S/N_2.4_ (SNR2p4)</DESCRIPTION>
    </FIELD>
    <FIELD name="y0" ucd="stat.fit.param" datatype="float" width="5" precision="2"><!-- ucd="FIT_PARAM_VALUE" -->
      <DESCRIPTION>[0.49/4.5] Cluster central Compton parameter measured at the 2.4' filter scale (y0tilde)</DESCRIPTION>
    </FIELD>
    <FIELD name="H13?" ucd="meta.code" datatype="unsignedByte" width="1"><!-- ucd="CODE_MISC" -->
      <DESCRIPTION>[0/1] Hasselfield+ 2013JCAP...07..008H match? (1=match) (H13Match)</DESCRIPTION>
    </FIELD>
    <FIELD name="PSZ2?" ucd="meta.code" datatype="unsignedByte" width="1"><!-- ucd="CODE_MISC" -->
      <DESCRIPTION>[0/1] Planck Col+ 2016, J/A+A/594/A27 match? (1=match) (PSZ2Match)</DESCRIPTION>
    </FIELD>
    <FIELD name="RM?" ucd="meta.code" datatype="unsignedByte" width="1"><!-- ucd="CODE_MISC" -->
      <DESCRIPTION>[0/1] RedMaPPer v5.10; Rykoff+ 2014, J/ApJ/785/104 match? (1=match) (RMMatch)</DESCRIPTION>
    </FIELD>
    <FIELD name="AName" ucd="meta.id" datatype="char" arraysize="29*"><!-- ucd="ID_ALTERNATIVE" -->
      <DESCRIPTION>Closest match listed on NED</DESCRIPTION>
    </FIELD>
