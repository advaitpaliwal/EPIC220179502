  <TABLE ID="J_ApJ_862_12_scussphz" name="J/ApJ/862/12/scussphz">
    <DESCRIPTION>Photometric redshifts of galaxies</DESCRIPTION>
    <!-- Definitions of GROUPs and FIELDs -->

<!-- +++No column could be found to attach a LINK in table: J/ApJ/862/12/scussphz -->
    <FIELD name="_r" ucd="pos.angDistance" datatype="double" width="4" precision="2"><!-- ucd="POS_ANG_DIST_GENERAL" -->
      <DESCRIPTION>Distance from center (014.80816-00.80760)[FK5/J2000]</DESCRIPTION>
    </FIELD>
    <FIELD name="objID" ucd="meta.id" datatype="long" width="19"><!-- ucd="ID_NUMBER" -->
      <DESCRIPTION>SDSS photometric object ID</DESCRIPTION>
    </FIELD>
    <FIELD name="Nn" ucd="meta.number" datatype="short" width="2"><!-- ucd="NUMBER" -->
      <DESCRIPTION>Number of the neighbors used for estimating the photometric redshift</DESCRIPTION>
    </FIELD>
    <FIELD name="Nf" ucd="meta.number" datatype="unsignedByte" width="1"><!-- ucd="NUMBER" -->
      <DESCRIPTION>Number of filters having r&lt;22mag and colors within color cuts</DESCRIPTION>
    </FIELD>
    <FIELD name="RAJ2000" ucd="pos.eq.ra;meta.main" ref="J2000" datatype="double" width="9" precision="5" unit="deg"><!-- ucd="POS_EQ_RA_MAIN" -->
      <DESCRIPTION>Right ascension (J2000)</DESCRIPTION>
    </FIELD>
    <FIELD name="DEJ2000" ucd="pos.eq.dec;meta.main" ref="J2000" datatype="double" width="9" precision="5" unit="deg"><!-- ucd="POS_EQ_DEC_MAIN" -->
      <DESCRIPTION>Declination (J2000)</DESCRIPTION>
    </FIELD>
    <FIELD name="zspec" ucd="src.redshift" datatype="float" width="7" precision="3"><!-- ucd="REDSHIFT_HC" -->
      <DESCRIPTION>? Spectroscopic redshift if exist</DESCRIPTION>
      <VALUES null="NaN" />
    </FIELD>
    <FIELD name="zphot" ucd="src.redshift" datatype="float" width="6" precision="3"><!-- ucd="REDSHIFT_PHOT" -->
      <DESCRIPTION>Estimated photometric redshift by the local linear regression model</DESCRIPTION>
    </FIELD>
    <FIELD name="zbias" ucd="stat.error" datatype="float" width="6" precision="3"><!-- ucd="ERROR" -->
      <DESCRIPTION>Bias of the photometric redshift estimated by the neighbors</DESCRIPTION>
    </FIELD>
    <FIELD name="zmean" ucd="src.redshift" datatype="float" width="6" precision="3"><!-- ucd="REDSHIFT_HC" -->
      <DESCRIPTION>Average spectroscopic redshift of the neighbors</DESCRIPTION>
    </FIELD>
    <FIELD name="zneareast" ucd="src.redshift;pos.heliocentric" datatype="float" width="6" precision="3"><!-- ucd="REDSHIFT_HC" -->
      <DESCRIPTION>Spectroscopic redshift of the nearest neighbor in the multi-dimension color space</DESCRIPTION>
    </FIELD>
    <FIELD name="meanDist" ucd="pos.distance" datatype="float" width="6" precision="3"><!-- ucd="PHYS_DISTANCE_NORM" -->
