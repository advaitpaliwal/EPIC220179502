    </FIELD>
    <FIELD name="logMtot" ucd="phys.mass" datatype="double" width="10" precision="5" unit="log(solMass)"><!-- ucd="PHYS_MASS_MISC" -->
      <DESCRIPTION>logarithm of the total mass of the group</DESCRIPTION>
    </FIELD>
    <FIELD name="logMstar" ucd="phys.mass" datatype="double" width="10" precision="5" unit="log(solMass)"><!-- ucd="PHYS_MASS_MISC" -->
      <DESCRIPTION>? logarithm of the minimal stellar mass (2)</DESCRIPTION>
      <VALUES null="NaN" />
    </FIELD>
    <FIELD name="NMstar" ucd="meta.number" datatype="int" width="6"><!-- ucd="NUMBER" -->
